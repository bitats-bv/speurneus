# Cloudflare Pages: HTTP-headers voor Speurneus.
# Dit bestand wordt mee gekopieerd naar dist/speurneus/browser/ en door Cloudflare gelezen.
#
# Caching: de bestanden die zeggen wélke versie de nieuwste is (index.html, ngsw.json,
# ngsw-worker.js, manifest) krijgen expliciet no-cache. Zo vraagt de iPad altijd na of er
# een nieuwe versie is, ook als Cloudflare of Safari ooit een andere standaard kiest.
# De app zelf kijkt bij openen en terugkeren of er een update is (src/app/app-update.ts).
# Enkel bestanden met een hash in de naam mogen voor altijd gecachet worden.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(self), camera=(self), geolocation=()

/main-*.js
  Cache-Control: public, max-age=31536000, immutable

/chunk-*.js
  Cache-Control: public, max-age=31536000, immutable

/polyfills-*.js
  Cache-Control: public, max-age=31536000, immutable

/styles-*.css
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/ngsw.json
  Cache-Control: no-cache

/ngsw-worker.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/safety-worker.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
